---
import { Icon } from "astro-icon/components";
---

<dialog
  id="dividend-dialog"
  aria-labelledby="dd-title"
  transition:persist="dividend-dialog"
  class="m-auto p-0 w-[min(580px,calc(100vw-32px))] border border-border bg-panel text-text shadow-popup backdrop:backdrop-blur-sm backdrop:bg-[var(--backdrop)]"
>
  <header class="px-7 pt-6 pb-5 border-b border-border">
    <div class="flex items-start justify-between gap-4 mb-3">
      <span
        data-field="badge"
        class="dd-badge inline-block px-2 py-1 text-[10px] font-bold tracking-[0.2em] bg-accent text-bg"
      >XD</span>
      <button
        type="button"
        data-close
        aria-label="Close"
        class="bg-transparent border-0 text-muted hover:text-text -mt-1 -mr-2 w-7 h-7 grid place-items-center cursor-pointer"
      >
        <Icon name="lucide:x" class="h-4 w-4" aria-hidden="true" />
      </button>
    </div>
    <h2 id="dd-title" class="m-0 leading-tight">
      <a
        data-field="symbol-link"
        href="#"
        class="group inline-flex items-baseline gap-1.5 font-display font-medium text-[1.5rem] tracking-tight text-text hover:text-accent no-underline transition-colors"
      >
        <strong data-field="symbol" class="font-medium"></strong>
        <Icon name="lucide:arrow-up-right" class="h-4 w-4 opacity-50 group-hover:opacity-100 transition-opacity" aria-hidden="true" />
      </a>
      <span class="text-muted text-[12px] tracking-[0.05em] mt-1 block uppercase" data-field="name"></span>
    </h2>
  </header>

  <dl class="grid grid-cols-2 gap-y-5 gap-x-7 px-7 py-6">
    <div>
      <dt class="text-[10px] text-muted uppercase tracking-[0.18em] font-semibold mb-1">Ex-date</dt>
      <dd class="m-0 text-[15px] tabular-nums font-display" data-field="exDate"></dd>
    </div>
    <div>
      <dt class="text-[10px] text-muted uppercase tracking-[0.18em] font-semibold mb-1">Record date</dt>
      <dd class="m-0 text-[15px] tabular-nums font-display" data-field="recordDate"></dd>
    </div>
    <div>
      <dt class="text-[10px] text-muted uppercase tracking-[0.18em] font-semibold mb-1">Payment date</dt>
      <dd class="m-0 text-[15px] tabular-nums font-display" data-field="paymentDate"></dd>
    </div>
    <div>
      <dt class="text-[10px] text-muted uppercase tracking-[0.18em] font-semibold mb-1">Type</dt>
      <dd class="m-0 text-[14px]" data-field="dividendType"></dd>
    </div>
    <div class="col-span-2 pt-3 border-t border-border/60">
      <dt class="text-[10px] text-muted uppercase tracking-[0.18em] font-semibold mb-1">Dividend</dt>
      <dd class="m-0">
        <span class="font-display text-[2rem] font-semibold leading-none tabular-nums" data-field="amount"></span>
        <span class="font-display italic text-muted text-[14px] ml-1">/ share</span>
      </dd>
    </div>
    <div>
      <dt class="text-[10px] text-muted uppercase tracking-[0.18em] font-semibold mb-1">Source</dt>
      <dd class="m-0 text-[13px]" data-field="source"></dd>
    </div>
    <div>
      <dt class="text-[10px] text-muted uppercase tracking-[0.18em] font-semibold mb-1">Operation period</dt>
      <dd class="m-0 text-[13px] tabular-nums font-display" data-field="operationPeriod"></dd>
    </div>
  </dl>

  <footer class="px-7 py-3 border-t border-border text-muted text-[10px] tracking-[0.15em] uppercase text-center">
    Source · SET Stock Calendar
  </footer>
</dialog>

<script>
  import { format, parseISO } from "date-fns";

  const BASE = (import.meta.env.BASE_URL ?? "/").replace(/\/$/, "");
  const dialog = document.getElementById("dividend-dialog") as HTMLDialogElement | null;
  if (dialog) {
    const set = (field: string, value: string) => {
      const el = dialog.querySelector(`[data-field="${field}"]`);
      if (el) el.textContent = value;
    };

    const formatAmount = (n: number): string =>
      n.toFixed(4).replace(/(\.\d{2})0+$/, "$1");

    const formatDate = (iso: string): string =>
      iso ? format(parseISO(iso), "dd MMM yyyy") : "—";

    const open = (btn: HTMLElement) => {
      const d = btn.dataset;
      const symbol = d.symbol ?? "";
      const tentative = d.tentative === "1";
      const amountRaw = d.amount ?? "";
      const isPayment = d.context === "payment";

      const badgeEl = dialog.querySelector('[data-field="badge"]') as HTMLElement | null;
      if (badgeEl) {
        badgeEl.textContent = isPayment ? "PAY" : (d.caType ?? "XD");
        badgeEl.classList.toggle("bg-accent", !isPayment);
        badgeEl.classList.toggle("bg-payment", isPayment);
      }

      set("symbol", tentative ? `${symbol} · tentative` : symbol);
      set("name", d.name ?? "");
      const symbolLink = dialog.querySelector<HTMLAnchorElement>('[data-field="symbol-link"]');
      if (symbolLink && symbol) symbolLink.href = `${BASE}/${symbol}/`;
      set("exDate", formatDate(d.exDate ?? ""));
      set("recordDate", formatDate(d.recordDate ?? ""));
      set("paymentDate", formatDate(d.paymentDate ?? ""));
      set("dividendType", d.dividendType || "Cash Dividend");
      set("source", d.source || "—");
      set(
        "operationPeriod",
        d.opStart && d.opEnd
          ? `${formatDate(d.opStart)} – ${formatDate(d.opEnd)}`
          : "—",
      );
      set(
        "amount",
        amountRaw === ""
          ? "Pending"
          : `${formatAmount(Number(amountRaw))} ฿`,
      );

      const amountEl = dialog.querySelector('[data-field="amount"]');
      if (amountEl) {
        const isPending = amountRaw === "";
        amountEl.classList.toggle("italic", isPending);
        amountEl.classList.toggle("text-muted", isPending);
        amountEl.classList.toggle("text-accent", !isPending && !isPayment);
        amountEl.classList.toggle("text-payment", !isPending && isPayment);
      }

      dialog.showModal();
    };

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      const trigger = target.closest<HTMLElement>("[data-event]");
      if (trigger) { open(trigger); return; }
      if (target.closest("[data-close]")) { dialog.close(); return; }
      if (target === dialog) dialog.close();
    });

    // Dialog is `transition:persist`, so it survives navigation. Close it
    // before any view-transition swap so users don't land on a new page with
    // a stale modal still open.
    document.addEventListener("astro:before-swap", () => {
      if (dialog.open) dialog.close();
    });
  }
</script>

<style>
  /* Entrance/exit transition for the native <dialog>. Uses @starting-style +
     transition-behavior: allow-discrete to animate the discrete `open` and
     overlay states. Falls back to no animation in older browsers. */
  #dividend-dialog {
    opacity: 0;
    transform: translateY(-6px) scale(0.97);
    transition:
      opacity 180ms ease-out,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1),
      overlay 220ms ease-out allow-discrete,
      display 220ms ease-out allow-discrete;
  }
  #dividend-dialog[open] {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
  @starting-style {
    #dividend-dialog[open] {
      opacity: 0;
      transform: translateY(-6px) scale(0.97);
    }
  }

  #dividend-dialog::backdrop {
    opacity: 0;
    transition:
      opacity 180ms ease-out,
      overlay 180ms ease-out allow-discrete,
      display 180ms ease-out allow-discrete;
  }
  #dividend-dialog[open]::backdrop {
    opacity: 1;
  }
  @starting-style {
    #dividend-dialog[open]::backdrop {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #dividend-dialog,
    #dividend-dialog::backdrop {
      transition: none;
    }
  }
</style>
