---
import { Icon } from "astro-icon/components";
import { withBase } from "../lib/dividends";
import { type Lang, t, localePath } from "../lib/i18n";

interface Props { lang: Lang; }
const { lang } = Astro.props;
---

<header class="px-4 sm:px-8 pt-6 sm:pt-7 pb-4 border-b border-border flex items-center gap-4">
  <a
    href={localePath(lang, "/")}
    class="inline-flex items-center gap-2 text-[11px] tracking-[0.18em] uppercase text-muted hover:text-text transition-colors"
  >
    <Icon name="lucide:chevron-left" class="h-3.5 w-3.5" aria-hidden="true" />
    <img src={withBase("/favicon.svg")} alt="" aria-hidden="true" class="h-6 w-6 sm:h-7 sm:w-7 shrink-0" />
    <span class="font-display italic normal-case tracking-normal text-[13px]">{t(lang, "stockBack")}</span>
    <span class="hidden sm:inline">, {t(lang, "stockBackCalendar")}</span>
  </a>
</header>
