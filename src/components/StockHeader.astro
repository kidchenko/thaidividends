---
import { Icon } from "astro-icon/components";
import ThemeToggle from "./ThemeToggle.astro";
import { withBase } from "../lib/dividends";
---

<header class="px-4 sm:px-8 pt-6 sm:pt-7 pb-4 border-b border-border flex items-center justify-between gap-4">
  <a
    href={withBase("/")}
    class="inline-flex items-center gap-2 text-[11px] tracking-[0.18em] uppercase text-muted hover:text-text transition-colors"
  >
    <Icon name="lucide:chevron-left" class="h-3.5 w-3.5" aria-hidden="true" />
    <img src={withBase("/favicon.svg")} alt="" aria-hidden="true" class="h-6 w-6 sm:h-7 sm:w-7 shrink-0" />
    <span class="font-display italic normal-case tracking-normal text-[13px]">The Daily Ledger</span>
    <span class="hidden sm:inline">· Calendar</span>
  </a>
  <ThemeToggle />
</header>
