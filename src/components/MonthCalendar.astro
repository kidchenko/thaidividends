---
import type { CalendarEntry, YearMonth } from "../lib/dividends";
import { monthGridDays, todayIso } from "../lib/dividends";
import { type Lang, tArr } from "../lib/i18n";

interface Props {
  lang: Lang;
  ym: YearMonth;
  byDay: Map<string, CalendarEntry[]>;
}

const { lang, ym, byDay } = Astro.props;
const days = monthGridDays(ym.year, ym.month);
const today = todayIso();
const dayLabels = tArr(lang, "weekdaysShort");
const dayLabelsMin = tArr(lang, "weekdaysMin");
---

<div class="grid grid-cols-7 border-t border-l border-border">
  {dayLabels.map((d, i) => (
    <div class="bg-bg text-muted text-[10px] uppercase tracking-[0.18em] text-center py-2 px-2 border-r border-b border-border font-semibold">
      <span class="hidden sm:inline">{d}</span>
      <span class="sm:hidden">{dayLabelsMin[i]}</span>
    </div>
  ))}
  {days.map((d) => {
    const isWeekend = d.weekday === 0 || d.weekday === 6;
    const entries = byDay.get(d.date) ?? [];
    const isToday = d.inMonth && d.date === today;
    const cellBg = !d.inMonth
      ? "bg-bg"
      : isWeekend
      ? "bg-weekend"
      : "bg-bg";
    return (
      <div class={`day-cell ${cellBg} min-h-[88px] sm:min-h-[110px] py-1.5 sm:py-2 px-1 sm:px-1.5 flex flex-col gap-1 sm:gap-1.5 border-r border-b border-border tabular-nums`}>
        <div class={`flex items-baseline justify-between px-0.5 sm:px-1 ${
          isToday ? "text-today" : d.inMonth ? "text-text" : "text-faint"
        }`}>
          <span class={`font-display tabular-nums leading-none ${
            isToday
              ? "text-[15px] sm:text-[18px] font-semibold border-b-2 border-today pb-0.5"
              : "text-[13px] sm:text-[15px] font-medium"
          }`}>
            {d.day}
          </span>
          {entries.length > 0 && d.inMonth && (
            <span class="text-[9px] uppercase tracking-wider text-muted font-sans">
              {entries.length}
            </span>
          )}
        </div>
        {d.inMonth && entries.length > 0 && (
          <div class="flex flex-col gap-px">
            {entries.map((entry) => {
              const e = entry.event;
              const isPayment = entry.kind === "payment";
              const colorClasses = isPayment
                ? "text-payment hover:bg-payment-soft border-l-payment"
                : e.tentative
                ? "text-accent hover:bg-accent-soft border-l-accent border-dashed"
                : "text-accent hover:bg-accent-soft border-l-accent";
              return (
                <button
                  type="button"
                  class={`group flex justify-between items-baseline gap-2 pl-1.5 sm:pl-2 pr-1 sm:pr-1.5 py-px text-[10px] sm:text-[11px] font-medium border-l-2 cursor-pointer text-left font-sans transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-accent ${colorClasses}`}
                  data-event
                  data-context={entry.kind}
                  data-symbol={e.symbol}
                  data-name={e.name}
                  data-ex-date={e.exDate}
                  data-record-date={e.recordDate ?? ""}
                  data-payment-date={e.paymentDate ?? ""}
                  data-amount={e.amount ?? ""}
                  data-currency={e.currency}
                  data-ca-type={e.caType}
                  data-dividend-type={e.dividendType}
                  data-source={e.sourceOfDividend ?? ""}
                  data-op-start={e.operationStart ?? ""}
                  data-op-end={e.operationEnd ?? ""}
                  data-tentative={e.tentative ? "1" : ""}
                  aria-label={`${e.symbol} on ${d.date}`}
                >
                  <span class="tracking-wide truncate flex-1 min-w-0">{e.symbol}</span>
                  <span class="hidden sm:inline text-muted font-display font-medium tabular-nums shrink-0">
                    {e.amount === null ? "—" : e.amount.toFixed(2)}
                  </span>
                </button>
              );
            })}
          </div>
        )}
      </div>
    );
  })}
</div>
