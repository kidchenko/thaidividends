---
import type { ValuationHistory, ValuationRow } from "../lib/fundamentals";
import { type Lang, t } from "../lib/i18n";

interface Props {
  lang: Lang;
  history: ValuationHistory;
  /** Current TTM yield = TTM dividends ÷ today's close. */
  currentYield?: number | null;
  /** Current P/E = today's close ÷ TTM EPS. */
  currentPE?: number | null;
}

const { lang, history, currentYield = null, currentPE = null } = Astro.props;

const fmtPct = (n: number): string => `${(n * 100).toFixed(2)}%`;
const fmtPe = (n: number): string => n.toFixed(1);

const showAnnual = history.annual.length >= 2;
const showQuarterly = history.quarterly.length >= 3;
const initialGrouping = showAnnual ? "year" : "quarter";

// --- Range stats from annual data ---
const yields = history.annual.map((r) => r.yld).filter((v) => v > 0);
const yieldMin = yields.length > 0 ? Math.min(...yields) : 0;
const yieldMax = yields.length > 0 ? Math.max(...yields) : 0;

const pes = history.annual.map((r) => r.pe).filter((v): v is number => v !== null && v > 0);
const peMin = pes.length > 0 ? Math.min(...pes) : 0;
const peMax = pes.length > 0 ? Math.max(...pes) : 0;

const positionLabel = (pos: number): string => {
  if (pos < 0.25) return t(lang, "valLow");
  if (pos < 0.75) return t(lang, "valTypical");
  return t(lang, "valHigh");
};

const positionFor = (val: number, min: number, max: number): number | null => {
  if (max <= min) return null;
  return (val - min) / (max - min);
};

// --- Headline picks ---
const latestYieldFallback =
  [...history.annual].reverse().find((r) => r.yld > 0) ??
  [...history.quarterly].reverse().find((r) => r.yld > 0) ??
  null;
const yieldHeadline = currentYield !== null ? currentYield : latestYieldFallback?.yld ?? null;
const yieldHeadlineLabel = currentYield !== null
  ? t(lang, "valCurrentYield")
  : t(lang, "valLatestYield");
const yieldHeadlineSub = currentYield !== null
  ? t(lang, "valTtm")
  : (latestYieldFallback ? latestYieldFallback.period : "");
const yieldPosition = yieldHeadline !== null && yields.length >= 2
  ? positionFor(yieldHeadline, yieldMin, yieldMax)
  : null;

const latestPeAnnual = [...history.annual].reverse().find((r) => r.pe !== null && r.pe > 0);
const latestPeQuarterly = [...history.quarterly].reverse().find((r) => r.pe !== null && r.pe > 0);
const latestPeRow =
  latestPeQuarterly && latestPeAnnual
    ? (latestPeQuarterly.date > latestPeAnnual.date ? latestPeQuarterly : latestPeAnnual)
    : (latestPeQuarterly ?? latestPeAnnual ?? null);
const peHeadline = currentPE !== null ? currentPE : latestPeRow?.pe ?? null;
const peHeadlineLabel = currentPE !== null
  ? t(lang, "valCurrentPe")
  : t(lang, "valLatestPe");
const peHeadlineSub = currentPE !== null
  ? t(lang, "valTtm")
  : (latestPeRow ? latestPeRow.period : "");
const pePosition = peHeadline !== null && pes.length >= 2
  ? positionFor(peHeadline, peMin, peMax)
  : null;

const hasAnyValuation = (yieldHeadline !== null) || (peHeadline !== null);

// --- Geometry shared by both charts ---
const W = 800;
const H = 200;     // shorter than before since we have two charts now
const PAD_T = 24;
const PAD_R = 18;
const PAD_B = 32;
const PAD_L = 56;
const chartW = W - PAD_L - PAD_R;
const chartH = H - PAD_T - PAD_B;

type Point = { x: number; y: number; r: ValuationRow; v: number };
type Layout = {
  segments: Point[][];
  bars: Array<{ x: number; w: number; y: number; h: number; r: ValuationRow; v: number }>;
  yMin: number;
  yMax: number;
  avg: number | null;
  current: number | null;
  yFor: (v: number) => number;
};

function layoutFor(
  rows: ValuationRow[],
  extract: (r: ValuationRow) => number | null,
  current: number | null,
): Layout {
  const valued: Array<{ idx: number; v: number }> = [];
  rows.forEach((r, i) => {
    const v = extract(r);
    if (v !== null && v > 0) valued.push({ idx: i, v });
  });
  if (valued.length === 0) {
    return {
      segments: [],
      bars: [],
      yMin: 0,
      yMax: 1,
      avg: null,
      current,
      yFor: () => PAD_T + chartH,
    };
  }
  const allValues = current !== null && current > 0
    ? [...valued.map((p) => p.v), current]
    : valued.map((p) => p.v);
  const yMinRaw = Math.min(...allValues);
  const yMaxRaw = Math.max(...allValues);
  const span = yMaxRaw - yMinRaw || Math.abs(yMaxRaw) || 1;
  const pad = span * 0.12;
  const yMin = Math.max(yMinRaw - pad, 0);
  const yMax = yMaxRaw + pad;
  const yFor = (v: number): number =>
    PAD_T + (1 - (v - yMin) / Math.max(yMax - yMin, 1e-9)) * chartH;
  const slotW = chartW / Math.max(rows.length - 1, 1);
  const xFor = (i: number): number =>
    rows.length === 1 ? PAD_L + chartW / 2 : PAD_L + slotW * i;

  const avg = valued.reduce((s, p) => s + p.v, 0) / valued.length;

  // Segments for line chart (yield)
  const segments: Point[][] = [];
  let cur: Point[] = [];
  let lastIdx = -2;
  for (const { idx, v } of valued) {
    const point: Point = { x: xFor(idx), y: yFor(v), r: rows[idx], v };
    if (idx === lastIdx + 1) {
      cur.push(point);
    } else {
      if (cur.length > 0) segments.push(cur);
      cur = [point];
    }
    lastIdx = idx;
  }
  if (cur.length > 0) segments.push(cur);

  // Bars for bar chart (P/E)
  const barSlotW = chartW / rows.length;
  const barW = Math.min(48, barSlotW * 0.6);
  const baselineY = PAD_T + chartH;
  const bars = valued.map(({ idx, v }) => {
    const x = PAD_L + barSlotW * idx + barSlotW / 2 - barW / 2;
    const y = yFor(v);
    return { x, w: barW, y, h: baselineY - y, r: rows[idx], v };
  });

  return { segments, bars, yMin, yMax, avg, current, yFor };
}

// Build per-grouping panes (each chart owns its own toggle, so we need
// the rows + layout for both year and quarter independently per chart).
type Grouping = "year" | "quarter";
type ChartPane = {
  kind: Grouping;
  rows: ValuationRow[];
  layout: Layout;
};
const yieldPanes: ChartPane[] = [];
const pePanes: ChartPane[] = [];
if (showAnnual) {
  yieldPanes.push({
    kind: "year",
    rows: history.annual,
    layout: layoutFor(history.annual, (r) => r.yld, currentYield),
  });
  pePanes.push({
    kind: "year",
    rows: history.annual,
    layout: layoutFor(history.annual, (r) => r.pe, currentPE),
  });
}
if (showQuarterly) {
  yieldPanes.push({
    kind: "quarter",
    rows: history.quarterly,
    layout: layoutFor(history.quarterly, (r) => r.yld, currentYield),
  });
  pePanes.push({
    kind: "quarter",
    rows: history.quarterly,
    layout: layoutFor(history.quarterly, (r) => r.pe, currentPE),
  });
}

const linePath = (pts: Point[]): string =>
  pts.map((p, i) => `${i === 0 ? "M" : "L"}${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(" ");
---

{(showAnnual || showQuarterly) && hasAnyValuation && (
  <section class="mb-14">
    <header class="flex items-baseline justify-between mb-4">
      <h2 class="m-0 font-display text-[clamp(1.25rem,2.5vw,1.625rem)] tracking-tight">
        <span class="italic font-light text-muted">{t(lang, "valSection")}</span>
        <span class="text-text/60 text-[14px] ml-2 font-sans normal-case tracking-normal">{t(lang, "valSectionSub")}</span>
      </h2>
    </header>

    <!-- Headline tiles -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-px bg-border border border-border mb-6">
      <div class="bg-bg p-3">
        <div class="text-[10px] uppercase tracking-[0.18em] text-muted mb-1">{yieldHeadlineLabel}</div>
        <div class="font-display tabular-nums text-xl font-medium text-payment">
          {yieldHeadline !== null ? fmtPct(yieldHeadline) : "—"}
        </div>
        <div class="font-display italic text-[12px] text-muted mt-1">
          {yieldPosition !== null ? positionLabel(yieldPosition) : yieldHeadlineSub}
        </div>
      </div>
      <div class="bg-bg p-3">
        <div class="text-[10px] uppercase tracking-[0.18em] text-muted mb-1">{t(lang, "valYieldRange")}</div>
        <div class="font-display tabular-nums text-xl font-medium text-text">
          {yields.length > 0 ? `${fmtPct(yieldMin)} – ${fmtPct(yieldMax)}` : "—"}
        </div>
        <div class="font-display italic text-[12px] text-muted mt-1">
          {history.annual.length > 0 ? `${history.annual[0].year}–${history.annual[history.annual.length - 1].year}` : ""}
        </div>
      </div>
      <div class="bg-bg p-3">
        <div class="text-[10px] uppercase tracking-[0.18em] text-muted mb-1">{peHeadlineLabel}</div>
        <div class="font-display tabular-nums text-xl font-medium text-text">
          {peHeadline !== null ? fmtPe(peHeadline) : "—"}
        </div>
        <div class="font-display italic text-[12px] text-muted mt-1">
          {pePosition !== null ? positionLabel(pePosition) : peHeadlineSub}
        </div>
      </div>
      <div class="bg-bg p-3">
        <div class="text-[10px] uppercase tracking-[0.18em] text-muted mb-1">{t(lang, "valPeRange")}</div>
        <div class="font-display tabular-nums text-xl font-medium text-text">
          {pes.length > 0 ? `${fmtPe(peMin)} – ${fmtPe(peMax)}` : "—"}
        </div>
        <div class="font-display italic text-[12px] text-muted mt-1">{t(lang, "valPeRangeHint")}</div>
      </div>
    </div>

    <div class="val-wrap relative">
      <!-- Yield chart (line) — independent grouping toggle -->
      <div class="val-chart mb-5" data-val-grouping={initialGrouping}>
        <div class="flex items-center gap-3 mb-2 flex-wrap">
          {showAnnual && showQuarterly && (
            <div class="inline-flex border border-border bg-panel rounded-sm overflow-hidden">
              <button
                type="button"
                data-val-grouping-btn="quarter"
                class="val-grouping-btn px-2.5 py-0.5 text-[11px] font-sans transition-colors cursor-pointer"
              >{t(lang, "epsGroupQuarter")}</button>
              <button
                type="button"
                data-val-grouping-btn="year"
                class="val-grouping-btn px-2.5 py-0.5 text-[11px] font-sans transition-colors cursor-pointer border-l border-border"
              >{t(lang, "tlGroupYear")}</button>
            </div>
          )}
          <span class="text-[11px] uppercase tracking-[0.18em] text-muted">{t(lang, "valChartYield")}</span>
        </div>
        {yieldPanes.map(({ kind, rows, layout: yldLayout }) => (
          <div data-val-grouping-pane={kind} class="val-pane">
            <svg viewBox={`0 0 ${W} ${H}`} class="w-full h-auto" role="img" aria-label="Yield over time">
              <line x1={PAD_L} y1={PAD_T} x2={W - PAD_R} y2={PAD_T} class="stroke-border" stroke-dasharray="2 4" />
              <line x1={PAD_L} y1={H - PAD_B} x2={W - PAD_R} y2={H - PAD_B} class="stroke-border" />

              <text
                x={PAD_L - 8} y={PAD_T + 4}
                text-anchor="end" class="fill-muted"
                style="font-size: 11px; font-family: var(--font-display); font-style: italic;"
              >{fmtPct(yldLayout.yMax)}</text>
              <text
                x={PAD_L - 8} y={H - PAD_B + 4}
                text-anchor="end" class="fill-muted"
                style="font-size: 11px; font-family: var(--font-display); font-style: italic;"
              >{fmtPct(yldLayout.yMin)}</text>

              {yldLayout.avg !== null && (
                <line
                  x1={PAD_L} y1={yldLayout.yFor(yldLayout.avg)}
                  x2={W - PAD_R} y2={yldLayout.yFor(yldLayout.avg)}
                  class="stroke-muted" stroke-dasharray="4 4" stroke-width="1"
                />
              )}
              {yldLayout.current !== null && yldLayout.current >= yldLayout.yMin && yldLayout.current <= yldLayout.yMax && (
                <line
                  x1={PAD_L} y1={yldLayout.yFor(yldLayout.current)}
                  x2={W - PAD_R} y2={yldLayout.yFor(yldLayout.current)}
                  class="stroke-payment" stroke-dasharray="2 3" stroke-width="1.5" opacity="0.85"
                />
              )}

              {yldLayout.segments.map((seg) => (
                <path d={linePath(seg)} fill="none" class="stroke-payment" stroke-width="2" stroke-linejoin="round" />
              ))}
              {yldLayout.segments.flat().map((p) => (
                <circle cx={p.x} cy={p.y} r="3.5" class="fill-payment stroke-payment" stroke-width="1.5" />
              ))}

              <!-- Hover targets per row -->
              {rows.map((r, i) => {
                const slotW = chartW / Math.max(rows.length - 1, 1);
                const x = rows.length === 1 ? PAD_L + chartW / 2 : PAD_L + slotW * i;
                return (
                  <g class="val-pt"
                    data-tip-period={r.period}
                    data-tip-yield={r.yld > 0 ? fmtPct(r.yld) : "—"}
                    data-tip-pe={r.pe !== null && r.pe > 0 ? fmtPe(r.pe) : "—"}
                    data-tip-close={r.close.toFixed(2)}
                  >
                    <rect x={x - 16} y={PAD_T} width="32" height={chartH} fill="transparent" />
                  </g>
                );
              })}

              {/* X-axis labels */}
              {rows.map((r, i) => {
                const slotW = chartW / Math.max(rows.length - 1, 1);
                const x = rows.length === 1 ? PAD_L + chartW / 2 : PAD_L + slotW * i;
                const showLabel = kind === "year"
                  || i === 0
                  || i === rows.length - 1
                  || i % Math.ceil(rows.length / 6) === 0;
                if (!showLabel) return null;
                return (
                  <text x={x} y={H - PAD_B + 18} text-anchor="middle" class="fill-muted"
                    style="font-size: 11px; font-family: var(--font-display); font-style: italic;">
                    {kind === "year" ? r.year : `Q${r.quarter}'${String(r.year).slice(-2)}`}
                  </text>
                );
              })}

              {yldLayout.avg !== null && (
                <g>
                  <rect x={W - PAD_R - 96} y={yldLayout.yFor(yldLayout.avg) - 14} width="96" height="12" class="fill-bg" opacity="0.85" />
                  <text x={W - PAD_R} y={yldLayout.yFor(yldLayout.avg) - 4} text-anchor="end" class="fill-muted"
                    style="font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; font-family: var(--font-display); font-style: italic;">
                    {t(lang, "tlAvg")} · {fmtPct(yldLayout.avg)}
                  </text>
                </g>
              )}
              {yldLayout.current !== null && yldLayout.current >= yldLayout.yMin && yldLayout.current <= yldLayout.yMax && (
                <g>
                  <rect x={PAD_L} y={yldLayout.yFor(yldLayout.current) - 14} width="96" height="12" class="fill-bg" opacity="0.85" />
                  <text x={PAD_L + 4} y={yldLayout.yFor(yldLayout.current) - 4} text-anchor="start"
                    class="fill-payment"
                    style="font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; font-family: var(--font-display); font-style: italic; font-weight: 600;">
                    {t(lang, "valNow")} · {fmtPct(yldLayout.current)}
                  </text>
                </g>
              )}
            </svg>
          </div>
        ))}
      </div>

      <!-- P/E chart (bars) — independent grouping toggle -->
      <div class="val-chart" data-val-grouping={initialGrouping}>
        <div class="flex items-center gap-3 mb-2 flex-wrap">
          {showAnnual && showQuarterly && (
            <div class="inline-flex border border-border bg-panel rounded-sm overflow-hidden">
              <button
                type="button"
                data-val-grouping-btn="quarter"
                class="val-grouping-btn px-2.5 py-0.5 text-[11px] font-sans transition-colors cursor-pointer"
              >{t(lang, "epsGroupQuarter")}</button>
              <button
                type="button"
                data-val-grouping-btn="year"
                class="val-grouping-btn px-2.5 py-0.5 text-[11px] font-sans transition-colors cursor-pointer border-l border-border"
              >{t(lang, "tlGroupYear")}</button>
            </div>
          )}
          <span class="text-[11px] uppercase tracking-[0.18em] text-muted">{t(lang, "valChartPe")}</span>
        </div>
        {pePanes.map(({ kind, rows, layout: peLayout }) => (
          <div data-val-grouping-pane={kind} class="val-pane">
            <svg viewBox={`0 0 ${W} ${H}`} class="w-full h-auto" role="img" aria-label="P/E over time">
              <line x1={PAD_L} y1={PAD_T} x2={W - PAD_R} y2={PAD_T} class="stroke-border" stroke-dasharray="2 4" />
              <line x1={PAD_L} y1={H - PAD_B} x2={W - PAD_R} y2={H - PAD_B} class="stroke-border" />

              {peLayout.bars.length > 0 ? (
                <text
                  x={PAD_L - 8} y={PAD_T + 4}
                  text-anchor="end" class="fill-muted"
                  style="font-size: 11px; font-family: var(--font-display); font-style: italic;"
                >{fmtPe(peLayout.yMax)}×</text>
              ) : (
                <text
                  x={W / 2} y={H / 2} text-anchor="middle" class="fill-muted"
                  style="font-size: 12px; font-family: var(--font-display); font-style: italic;"
                >{t(lang, "valPeNoData")}</text>
              )}

              {peLayout.avg !== null && (
                <line
                  x1={PAD_L} y1={peLayout.yFor(peLayout.avg)}
                  x2={W - PAD_R} y2={peLayout.yFor(peLayout.avg)}
                  class="stroke-muted" stroke-dasharray="4 4" stroke-width="1"
                />
              )}
              {peLayout.current !== null && peLayout.current >= peLayout.yMin && peLayout.current <= peLayout.yMax && (
                <line
                  x1={PAD_L} y1={peLayout.yFor(peLayout.current)}
                  x2={W - PAD_R} y2={peLayout.yFor(peLayout.current)}
                  class="stroke-accent" stroke-dasharray="2 3" stroke-width="1.5" opacity="0.85"
                />
              )}

              <!-- Bars: color reflects above/below avg as a subtle valuation cue.
                   Above avg = filled accent (expensive); below avg = soft accent (cheap). -->
              {peLayout.bars.map((b) => {
                const aboveAvg = peLayout.avg !== null && b.v > peLayout.avg;
                return (
                  <g class="val-pt"
                    data-tip-period={b.r.period}
                    data-tip-yield={b.r.yld > 0 ? fmtPct(b.r.yld) : "—"}
                    data-tip-pe={fmtPe(b.v)}
                    data-tip-close={b.r.close.toFixed(2)}
                  >
                    <rect
                      x={b.x} y={b.y} width={b.w} height={Math.max(b.h, 1)}
                      class={aboveAvg ? "fill-accent stroke-accent" : "fill-accent-soft stroke-accent"}
                      stroke-width="1.5"
                    />
                    <text
                      x={b.x + b.w / 2} y={b.y - 4}
                      text-anchor="middle" class="fill-text"
                      style="font-size: 10px; font-family: var(--font-display); font-weight: 500;"
                    >{fmtPe(b.v)}</text>
                  </g>
                );
              })}

              {/* X-axis labels — same positions as yield chart */}
              {rows.map((r, i) => {
                const barSlotW = chartW / rows.length;
                const x = PAD_L + barSlotW * i + barSlotW / 2;
                const showLabel = kind === "year"
                  || i === 0
                  || i === rows.length - 1
                  || i % Math.ceil(rows.length / 6) === 0;
                if (!showLabel) return null;
                return (
                  <text x={x} y={H - PAD_B + 18} text-anchor="middle" class="fill-muted"
                    style="font-size: 11px; font-family: var(--font-display); font-style: italic;">
                    {kind === "year" ? r.year : `Q${r.quarter}'${String(r.year).slice(-2)}`}
                  </text>
                );
              })}

              {peLayout.avg !== null && (
                <g>
                  <rect x={W - PAD_R - 80} y={peLayout.yFor(peLayout.avg) - 14} width="80" height="12" class="fill-bg" opacity="0.85" />
                  <text x={W - PAD_R} y={peLayout.yFor(peLayout.avg) - 4} text-anchor="end" class="fill-muted"
                    style="font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; font-family: var(--font-display); font-style: italic;">
                    {t(lang, "tlAvg")} · {fmtPe(peLayout.avg)}×
                  </text>
                </g>
              )}
              {peLayout.current !== null && peLayout.current >= peLayout.yMin && peLayout.current <= peLayout.yMax && (
                <g>
                  <rect x={PAD_L} y={peLayout.yFor(peLayout.current) - 14} width="80" height="12" class="fill-bg" opacity="0.85" />
                  <text x={PAD_L + 4} y={peLayout.yFor(peLayout.current) - 4} text-anchor="start"
                    class="fill-accent"
                    style="font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; font-family: var(--font-display); font-style: italic; font-weight: 600;">
                    {t(lang, "valNow")} · {fmtPe(peLayout.current)}×
                  </text>
                </g>
              )}
            </svg>
          </div>
        ))}
      </div>

      <!-- Tooltip -->
      <div
        data-val-tooltip
        role="tooltip"
        class="pointer-events-none absolute z-20 hidden -translate-x-1/2 -translate-y-full
               bg-text text-bg px-2.5 py-1.5 text-[11px] leading-tight
               whitespace-nowrap border border-text rounded-sm"
      >
        <div data-tip-slot="period" class="font-display font-semibold text-[13px] tabular-nums"></div>
        <div class="opacity-90 mt-1"><span class="opacity-70">{t(lang, "valTipYield")}:</span> <span data-tip-slot="yield"></span></div>
        <div class="opacity-90"><span class="opacity-70">{t(lang, "valTipPe")}:</span> <span data-tip-slot="pe"></span></div>
        <div class="opacity-50 text-[10px] uppercase tracking-[0.12em] mt-1"><span data-tip-slot="close"></span> ฿ {t(lang, "valTipClose")}</div>
      </div>
    </div>
  </section>
)}

<script>
  document.addEventListener("click", (e) => {
    const groupBtn = (e.target as HTMLElement).closest<HTMLElement>("[data-val-grouping-btn]");
    if (groupBtn) {
      const chart = groupBtn.closest<HTMLElement>(".val-chart");
      if (chart) chart.dataset.valGrouping = groupBtn.dataset.valGroupingBtn ?? "year";
    }
  });

  const showValTip = (g: SVGGElement) => {
    const wrap = g.closest<HTMLElement>(".val-wrap");
    if (!wrap) return;
    const tooltip = wrap.querySelector<HTMLElement>("[data-val-tooltip]");
    if (!tooltip) return;
    const set = (name: string, value: string) => {
      const el = tooltip.querySelector<HTMLElement>(`[data-tip-slot="${name}"]`);
      if (el) el.textContent = value;
    };
    set("period", g.dataset.tipPeriod ?? "");
    set("yield", g.dataset.tipYield ?? "");
    set("pe", g.dataset.tipPe ?? "");
    set("close", g.dataset.tipClose ?? "");
    tooltip.classList.remove("hidden");
    const wrapRect = wrap.getBoundingClientRect();
    const gRect = (g as unknown as SVGGraphicsElement).getBoundingClientRect();
    tooltip.style.left = `${gRect.left - wrapRect.left + gRect.width / 2}px`;
    tooltip.style.top = `${gRect.top - wrapRect.top + 20}px`;
  };
  const hideValTip = (g: SVGGElement) => {
    g.closest<HTMLElement>(".val-wrap")?.querySelector<HTMLElement>("[data-val-tooltip]")?.classList.add("hidden");
  };
  document.addEventListener("mouseover", (e) => {
    const g = (e.target as HTMLElement).closest<SVGGElement>(".val-pt");
    if (g) showValTip(g);
  });
  document.addEventListener("mouseout", (e) => {
    const g = (e.target as HTMLElement).closest<SVGGElement>(".val-pt");
    if (g) hideValTip(g);
  });
</script>

<style>
  .val-pt { cursor: pointer; transition: filter 100ms ease; }
  .val-pt:hover { filter: brightness(1.15); }

  .val-chart[data-val-grouping="year"] [data-val-grouping-btn="year"],
  .val-chart[data-val-grouping="quarter"] [data-val-grouping-btn="quarter"] {
    background: var(--text);
    color: var(--bg);
  }
  .val-chart[data-val-grouping="year"] [data-val-grouping-btn="quarter"],
  .val-chart[data-val-grouping="quarter"] [data-val-grouping-btn="year"] {
    background: transparent;
    color: var(--muted);
  }

  .val-chart [data-val-grouping-pane] { display: none; }
  .val-chart[data-val-grouping="year"] [data-val-grouping-pane="year"],
  .val-chart[data-val-grouping="quarter"] [data-val-grouping-pane="quarter"] {
    display: block;
  }
</style>
