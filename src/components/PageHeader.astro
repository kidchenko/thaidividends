---
import { Icon } from "astro-icon/components";
import CalendarSubscribe from "./CalendarSubscribe.astro";
import { withBase } from "../lib/dividends";
import { type Lang, t } from "../lib/i18n";

interface Props {
  lang: Lang;
  totalXdMonth: number;
  totalPaymentMonth: number;
  totalAll: number;
  uniqueSymbols: number;
  feedUrl?: string;
}

const { lang, totalXdMonth, totalPaymentMonth, totalAll, uniqueSymbols, feedUrl } = Astro.props;
const logoHref = withBase("/favicon.svg");

const pillBase =
  "filter-pill inline-flex items-baseline gap-2 px-2.5 py-1 text-[12px] cursor-pointer transition focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent";
---

<header
  transition:name="page-header"
  class="header-grid px-4 sm:px-8 pt-6 sm:pt-10 pb-5 sm:pb-6 border-b-2 border-text/90"
>
  <div class="area-title min-w-0 max-w-xl">
    <div class="flex items-center gap-3 sm:gap-4 mb-3">
      <img src={logoHref} alt="" aria-hidden="true" class="shrink-0 h-12 w-12 sm:h-16 sm:w-16 md:h-20 md:w-20" />
      <h1 class="m-0 font-display text-[clamp(2rem,4vw,3.25rem)] leading-[0.95] tracking-tight text-text">
        <span class="italic font-light">{t(lang, "brand1")}</span>
        <span class="block font-semibold">{t(lang, "brand2")}</span>
      </h1>
    </div>
    <div class="flex items-center gap-3 text-[10px] tracking-[0.22em] uppercase text-text/80 mb-2">
      <span class="inline-block h-px w-6 bg-text/60"></span>
      <span>{t(lang, "volLine")}</span>
    </div>
    <p class="mt-3 text-text/85 text-[13px] max-w-md">
      {t(lang, "tagline")}
    </p>
  </div>

  <form role="search" class="area-search search-form relative w-full sm:w-auto sm:min-w-[240px] sm:max-w-[400px] sm:flex-1 sm:justify-self-end" onsubmit="return false">
    <Icon
      name="lucide:search"
      class="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted pointer-events-none"
      aria-hidden="true"
    />
    <input
      type="search"
      data-search
      placeholder={t(lang, "searchPlaceholder")}
      aria-label={t(lang, "searchAria")}
      autocomplete="off"
      class="w-full h-10 rounded-none border-0 border-b border-text/30 bg-transparent pl-9 pr-9 text-sm text-text placeholder:text-muted focus:outline-none focus:border-text"
    />
    <button
      type="button"
      data-search-clear
      aria-label={t(lang, "clearSearch")}
      class="search-clear absolute right-1 top-1/2 -translate-y-1/2 hidden h-7 w-7 place-items-center rounded text-muted hover:text-text cursor-pointer"
    >
      <Icon name="lucide:x" class="h-4 w-4" aria-hidden="true" />
    </button>
  </form>

  <div class="area-pills flex gap-4 text-[12px] flex-wrap items-center">
    <button type="button" class={pillBase} data-filter="xd" aria-pressed="true">
      <span class="dot inline-block w-1.5 h-3 bg-accent transition"></span>
      <strong class="text-text font-semibold tabular-nums" data-count="xd">{totalXdMonth}</strong>
      <span class="label text-muted lowercase tracking-wide">{t(lang, "pillExDividend")}</span>
    </button>
    <span class="text-faint">&middot;</span>
    <button type="button" class={pillBase} data-filter="payment" aria-pressed="true">
      <span class="dot inline-block w-1.5 h-3 bg-payment transition"></span>
      <strong class="text-text font-semibold tabular-nums" data-count="payment">{totalPaymentMonth}</strong>
      <span class="label text-muted lowercase tracking-wide">{t(lang, "pillPayment")}</span>
    </button>
    <span class="text-faint">&middot;</span>
    <span class="text-muted">
      <strong class="font-display italic font-medium text-text mr-1.5 tabular-nums">{totalAll.toLocaleString()}</strong>
      {t(lang, "trackedAcross")}
      <strong class="font-display italic font-medium text-text mx-1 tabular-nums">{uniqueSymbols}</strong>
      {t(lang, "tickers")}
    </span>
    <span data-empty-hint class="hidden text-muted italic ml-2">{t(lang, "noMatches")}</span>
    {feedUrl && (
      <span class="ml-auto">
        <CalendarSubscribe lang={lang} feedUrl={feedUrl} align="right" variant="compact" />
      </span>
    )}
  </div>
</header>

<script>
  // Single-bind script - listeners attach once at module load. After each
  // ClientRouter navigation, `astro:page-load` re-runs init() so we can
  // re-query DOM nodes and recompute counts against the new month's cards.

  type FilterKey = "xd" | "payment";
  const STORAGE = { xd: "filter-xd", payment: "filter-payment" } as const;
  const HTML_ATTR = { xd: "hideXd", payment: "hidePayment" } as const;

  let searchInput: HTMLInputElement | null = null;
  let clearBtn: HTMLButtonElement | null = null;
  let emptyHint: HTMLElement | null = null;
  let countEls: { xd: HTMLElement | null; payment: HTMLElement | null } = {
    xd: null, payment: null,
  };
  let query = "";

  const isOn = (key: FilterKey): boolean => {
    try { return localStorage.getItem(STORAGE[key]) !== "0"; } catch { return true; }
  };

  const recompute = () => {
    const cards = document.querySelectorAll<HTMLElement>("[data-event]");
    let xdVisible = 0;
    let payVisible = 0;
    for (const card of cards) {
      const symbol = (card.dataset.symbol ?? "").toLowerCase();
      const name = (card.dataset.name ?? "").toLowerCase();
      const matches = !query || symbol.includes(query) || name.includes(query);
      card.classList.toggle("match-hidden", !matches);
      if (!matches) continue;
      const kind = card.dataset.context as FilterKey | undefined;
      if (kind === "xd") xdVisible++;
      else if (kind === "payment") payVisible++;
    }
    if (countEls.xd) countEls.xd.textContent = String(xdVisible);
    if (countEls.payment) countEls.payment.textContent = String(payVisible);

    if (emptyHint) {
      const xdHidden = !isOn("xd");
      const payHidden = !isOn("payment");
      const visibleAfterPill =
        (xdHidden ? 0 : xdVisible) + (payHidden ? 0 : payVisible);
      emptyHint.classList.toggle("hidden", visibleAfterPill > 0);
    }
  };

  const syncPill = (key: FilterKey, on: boolean) => {
    document.querySelectorAll<HTMLButtonElement>(`[data-filter="${key}"]`).forEach((btn) => {
      btn.setAttribute("aria-pressed", on ? "true" : "false");
      btn.classList.toggle("opacity-40", !on);
    });
  };

  const applyPill = (key: FilterKey, on: boolean) => {
    const html = document.documentElement;
    if (on) delete html.dataset[HTML_ATTR[key]];
    else html.dataset[HTML_ATTR[key]] = "1";
    try { localStorage.setItem(STORAGE[key], on ? "1" : "0"); } catch {}
    syncPill(key, on);
    recompute();
  };

  const setQuery = (v: string) => {
    query = v.trim().toLowerCase();
    if (clearBtn) {
      clearBtn.classList.toggle("hidden", query.length === 0);
      clearBtn.classList.toggle("grid", query.length > 0);
    }
    recompute();
  };

  // Re-bind DOM references and re-sync UI after every navigation.
  const init = () => {
    searchInput = document.querySelector<HTMLInputElement>("[data-search]");
    clearBtn = document.querySelector<HTMLButtonElement>("[data-search-clear]");
    emptyHint = document.querySelector<HTMLElement>("[data-empty-hint]");
    countEls = {
      xd: document.querySelector<HTMLElement>('[data-count="xd"]'),
      payment: document.querySelector<HTMLElement>('[data-count="payment"]'),
    };
    if (searchInput && query) searchInput.value = query;
    for (const key of ["xd", "payment"] as FilterKey[]) syncPill(key, isOn(key));
    recompute();
  };

  document.addEventListener("input", (e) => {
    const target = e.target as HTMLElement;
    if (target.matches("[data-search]")) {
      setQuery((target as HTMLInputElement).value);
    }
  });

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target.closest("[data-search-clear]")) {
      if (searchInput) searchInput.value = "";
      setQuery("");
      searchInput?.focus();
      return;
    }
    const filterBtn = target.closest<HTMLButtonElement>("[data-filter]");
    if (filterBtn) {
      const key = filterBtn.dataset.filter as FilterKey;
      applyPill(key, !isOn(key));
    }
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "/" && document.activeElement?.tagName !== "INPUT") {
      e.preventDefault();
      searchInput?.focus();
    }
    if (e.key === "Escape" && document.activeElement === searchInput) {
      if (searchInput && searchInput.value) {
        searchInput.value = "";
        setQuery("");
      } else {
        searchInput?.blur();
      }
    }
  });

  document.addEventListener("astro:page-load", init);
</script>

<style>
  /* Mobile: title row, search wraps below, pills below that. */
  .header-grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas:
      "title"
      "search"
      "pills";
    column-gap: 1rem;
    row-gap: 1.25rem;
    align-items: end;
  }
  /* Desktop: title left, search inline right. Toggles live in MainNav. */
  @media (min-width: 640px) {
    .header-grid {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "title search"
        "pills pills";
      column-gap: 1rem;
      row-gap: 1.75rem;
    }
  }
  .area-title { grid-area: title; }
  .area-search { grid-area: search; }
  .area-pills { grid-area: pills; }

  .filter-pill[aria-pressed="false"] .label { text-decoration: line-through; }
  .filter-pill[aria-pressed="false"] .dot {
    background: transparent;
    box-shadow: inset 0 0 0 1px currentColor;
    color: var(--muted);
  }
</style>
