---
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/Layout.astro";
import MainNav from "../../components/MainNav.astro";
import StockHeader from "../../components/StockHeader.astro";
import StarButton from "../../components/StarButton.astro";
import {
  loadEvents,
  getUpcomingDays,
  getLastPaidPerSymbol,
  symbolPath,
  todayIso,
  type CalendarEntry,
} from "../../lib/dividends";
import { LANGS, isLang, t, fmtDate, localePath, type Lang } from "../../lib/i18n";

export async function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = (isLang(Astro.params.lang) ? Astro.params.lang : "en") as Lang;

const events = loadEvents();
const today = todayIso();
const upcoming = getUpcomingDays(events, today);
const lastPaidMap = getLastPaidPerSymbol(events, today);
const lastPaidEntries = [...lastPaidMap.entries()]
  .map(([symbol, event]) => ({ symbol, event }))
  .sort((a, b) =>
    (b.event.paymentDate ?? "").localeCompare(a.event.paymentDate ?? "") ||
    a.symbol.localeCompare(b.symbol),
  );
const todayYear = new Date().getFullYear();
const stockBasePath = localePath(lang, "/");

const formatAmount = (n: number): string =>
  n.toFixed(4).replace(/(\.\d{2})0+$/, "$1");

const formatDateLong = (iso: string): string => fmtDate(iso, "EEE, dd MMM yyyy", lang);
---

<Layout lang={lang} title={`${t(lang, "watchlistTitle")} - ${t(lang, "siteTitle")}`}>
  <MainNav lang={lang} active="watchlist" annualYear={todayYear} />
  <StockHeader lang={lang} />

  <main class="px-3 sm:px-8 pt-6 sm:pt-12 pb-16 max-w-[760px] mx-auto">
    <!-- Masthead -->
    <section class="mb-6 sm:mb-10">
      <div class="flex items-baseline gap-3 text-[10px] tracking-[0.22em] uppercase text-muted mb-3">
        <span class="inline-block h-px w-6 bg-text/40"></span>
        <span>{t(lang, "navWatchlist")}</span>
      </div>
      <h1 class="m-0 font-display text-[clamp(2.25rem,7vw,4.5rem)] leading-[0.92] tracking-tight text-text flex items-baseline gap-3 flex-wrap">
        <Icon name="lucide:star" class="watchlist-star inline-block h-[0.7em] w-[0.7em] shrink-0" aria-hidden="true" />
        <span class="font-semibold">{t(lang, "watchlistTitle")}</span>
      </h1>
      <p class="mt-3 text-text/85 text-[13px] max-w-md">
        <span data-watchlist-count>0</span>
        <span class="text-muted"> {t(lang, "watchlistCount")}</span>
        <span class="text-muted">, </span>
        <span class="text-muted">{t(lang, "watchlistSubtitle")}</span>
      </p>
    </section>

    <!-- Empty state - shown when localStorage watchlist is empty. -->
    <section data-watchlist-empty class="hidden border border-border bg-panel/40 p-8 sm:p-12 text-center">
      <Icon name="lucide:star" class="mx-auto h-8 w-8 text-faint mb-4" aria-hidden="true" />
      <h2 class="m-0 font-display italic text-[clamp(1.25rem,3vw,1.75rem)] text-text mb-2">
        {t(lang, "watchlistEmptyTitle")}
      </h2>
      <p class="text-muted text-[13px] max-w-sm mx-auto mb-5">
        {t(lang, "watchlistEmptyBody")}
      </p>
      <a
        href={localePath(lang, "/stocks/")}
        class="inline-block text-accent text-[13px] font-medium border-b border-accent/40 hover:border-accent transition-colors no-underline hover:no-underline"
      >
        {t(lang, "watchlistEmptyCta")}
      </a>
    </section>

    <!-- Starred chips - populated from localStorage. Shown when watchlist is non-empty,
         regardless of whether the starred stocks have upcoming events. -->
    <section
      data-watchlist-chips
      data-stock-base={stockBasePath}
      class="hidden border-t border-border pt-4 pb-6"
    >
      <div class="flex items-baseline gap-3 text-[10px] tracking-[0.22em] uppercase text-muted mb-3">
        <span>{t(lang, "starredHeading")}</span>
        <span class="text-faint" data-chips-count></span>
      </div>
      <ul class="m-0 p-0 list-none flex flex-wrap gap-2" data-chips></ul>
    </section>

    <!-- "No upcoming" hint - shown when watchlist is non-empty but has neither
         upcoming events nor last-paid history visible. -->
    <p data-watchlist-no-upcoming class="hidden text-muted italic text-[14px] py-8 text-center">
      {t(lang, "noUpcoming")}
    </p>

    <!-- Upcoming events grouped by date -->
    <section data-watchlist-list class="hidden">
      {upcoming.length > 0 ? (
        <ol class="m-0 p-0 list-none">
          {upcoming.map((day) => (
            <li class="day-block border-t border-border" data-day data-date={day.date}>
              <header class="flex items-baseline gap-3 pt-4 pb-2">
                <span class="font-display tabular-nums text-[clamp(1rem,2.5vw,1.25rem)] font-medium text-text">
                  {formatDateLong(day.date)}
                </span>
              </header>
              <ul class="m-0 p-0 list-none flex flex-col">
                {day.entries.map((entry: CalendarEntry) => {
                  const e = entry.event;
                  const isPayment = entry.kind === "payment";
                  return (
                    <li
                      class="watch-row grid grid-cols-[1.75rem_minmax(0,1fr)_auto_auto] sm:grid-cols-[2rem_minmax(0,1fr)_auto_auto] items-center gap-2 sm:gap-3 py-2.5 border-t border-border/40"
                      data-row
                      data-symbol={e.symbol}
                    >
                      <span class={`watch-kind text-[9px] uppercase tracking-[0.18em] font-bold text-center px-1 py-0.5 ${
                        isPayment ? "text-payment border border-payment/40" : "text-accent border border-accent/40"
                      }`}>
                        {isPayment ? t(lang, "badgePay") : t(lang, "badgeXd")}
                      </span>
                      <a
                        href={symbolPath(lang, e.symbol)}
                        class="min-w-0 flex items-baseline gap-2 no-underline hover:no-underline group"
                      >
                        <span class="font-display font-medium text-text group-hover:text-accent transition-colors shrink-0">
                          {e.symbol}
                        </span>
                        <span class="hidden sm:inline truncate text-muted text-[12px]">
                          {e.name}
                        </span>
                      </a>
                      <span class={`font-display tabular-nums leading-none text-[13px] sm:text-sm whitespace-nowrap shrink-0 ${
                        e.amount === null ? "text-muted italic" : "text-text font-semibold"
                      }`}>
                        {e.amount === null ? "-" : formatAmount(e.amount)}
                        <span class="text-muted text-[10px] ml-0.5">฿</span>
                      </span>
                      <StarButton lang={lang} symbol={e.symbol} variant="row" />
                    </li>
                  );
                })}
              </ul>
            </li>
          ))}
        </ol>
      ) : (
        <p class="text-muted italic text-[14px] py-12 text-center">{t(lang, "noUpcoming")}</p>
      )}
    </section>

    <!-- Last paid - shown when starred stocks have no upcoming events. JS hides
         rows for symbols not in the watchlist (or that have an upcoming event). -->
    <section data-watchlist-last-paid class="hidden border-t border-border pt-4 pb-2 mt-2">
      <div class="flex items-baseline gap-3 text-[10px] tracking-[0.22em] uppercase text-muted mb-3">
        <span>{t(lang, "lastPaidHeading")}</span>
        <span class="text-faint normal-case tracking-normal italic">({t(lang, "lastPaidNote")})</span>
      </div>
      <ul class="m-0 p-0 list-none flex flex-col">
        {lastPaidEntries.map(({ symbol, event }) => (
          <li
            class="last-paid-row grid grid-cols-[1.75rem_minmax(0,1fr)_auto_auto] sm:grid-cols-[2rem_minmax(0,1fr)_auto_auto] items-center gap-2 sm:gap-3 py-2.5 border-t border-border/40 first:border-t-0"
            data-last-paid-row
            data-symbol={symbol}
          >
            <span class="text-[9px] uppercase tracking-[0.18em] font-bold text-center px-1 py-0.5 text-payment border border-payment/40">
              {t(lang, "badgePay")}
            </span>
            <a
              href={symbolPath(lang, symbol)}
              class="min-w-0 flex items-baseline gap-2 no-underline hover:no-underline group"
            >
              <span class="font-display font-medium text-text group-hover:text-accent transition-colors shrink-0">
                {symbol}
              </span>
              <span class="hidden sm:inline truncate text-muted text-[12px]">
                {event.name}
              </span>
              <span class="text-faint text-[11px] italic shrink-0">
                {t(lang, "paidOn")} {formatDateLong(event.paymentDate as string)}
              </span>
            </a>
            <span class={`font-display tabular-nums leading-none text-[13px] sm:text-sm whitespace-nowrap shrink-0 ${
              event.amount === null ? "text-muted italic" : "text-text font-semibold"
            }`}>
              {event.amount === null ? "-" : formatAmount(event.amount)}
              <span class="text-muted text-[10px] ml-0.5">฿</span>
            </span>
            <StarButton lang={lang} symbol={symbol} variant="row" />
          </li>
        ))}
      </ul>
    </section>
  </main>
</Layout>

<style>
  .watchlist-star { fill: currentColor; color: var(--accent); }
  /* Day blocks and rows hidden when their symbol isn't in the watchlist. */
  [data-row].watch-hidden { display: none; }
  [data-day].watch-hidden { display: none; }
  [data-last-paid-row].watch-hidden { display: none; }

  /* Starred chips - :global() because chips are injected via innerHTML and
     don't carry the Astro-scoped attribute. */
  :global(.chip) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 10px 6px 12px;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 13px;
    line-height: 1;
    transition: border-color 0.15s, background 0.15s, color 0.15s;
  }
  :global(.chip:hover) {
    border-color: var(--accent);
    background: var(--panel);
  }
  :global(.chip-link) {
    color: inherit;
    text-decoration: none;
    transition: color 0.15s;
  }
  :global(.chip-link:hover) {
    color: var(--accent);
    text-decoration: none;
  }
  :global(.chip-unstar) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font-size: 16px;
    line-height: 1;
    border-radius: 999px;
    transition: color 0.15s, background 0.15s;
  }
  :global(.chip-unstar:hover) {
    color: var(--bg);
    background: var(--accent);
  }
</style>

<script>
  import { readWatchlist, toggleStar, onWatchlistChange } from "../../lib/watchlist";

  function paintChips(starred: Set<string>) {
    const section = document.querySelector<HTMLElement>("[data-watchlist-chips]");
    const list = document.querySelector<HTMLUListElement>("[data-chips]");
    const count = document.querySelector<HTMLElement>("[data-chips-count]");
    if (!section || !list) return;
    if (starred.size === 0) {
      section.classList.add("hidden");
      list.innerHTML = "";
      return;
    }
    section.classList.remove("hidden");
    if (count) count.textContent = `(${starred.size})`;
    const stockBase = section.dataset.stockBase ?? "/";
    const sorted = [...starred].sort();
    list.innerHTML = sorted
      .map(
        (sym) => `
          <li>
            <span class="chip" data-chip>
              <a href="${stockBase}${encodeURIComponent(sym)}/" class="chip-link">${sym}</a>
              <button
                type="button"
                class="chip-unstar"
                data-chip-unstar
                data-symbol="${sym.replace(/"/g, "&quot;")}"
                aria-label="Remove ${sym} from watchlist"
                title="Remove ${sym} from watchlist"
              >×</button>
            </span>
          </li>
        `,
      )
      .join("");
  }

  function applyFilter() {
    const starred = readWatchlist();
    const list = document.querySelector<HTMLElement>("[data-watchlist-list]");
    const empty = document.querySelector<HTMLElement>("[data-watchlist-empty]");
    const noUpcoming = document.querySelector<HTMLElement>("[data-watchlist-no-upcoming]");
    const countEl = document.querySelector<HTMLElement>("[data-watchlist-count]");
    if (countEl) countEl.textContent = String(starred.size);

    paintChips(starred);

    if (starred.size === 0) {
      empty?.classList.remove("hidden");
      list?.classList.add("hidden");
      noUpcoming?.classList.add("hidden");
      return;
    }
    empty?.classList.add("hidden");
    list?.classList.remove("hidden");

    let visibleRows = 0;
    const upcomingSymbols = new Set<string>();
    document.querySelectorAll<HTMLElement>("[data-row]").forEach((row) => {
      const sym = row.dataset.symbol ?? "";
      const visible = starred.has(sym);
      row.classList.toggle("watch-hidden", !visible);
      if (visible) {
        visibleRows++;
        upcomingSymbols.add(sym);
      }
    });

    document.querySelectorAll<HTMLElement>("[data-day]").forEach((day) => {
      const allHidden = Array.from(day.querySelectorAll<HTMLElement>("[data-row]"))
        .every((r) => r.classList.contains("watch-hidden"));
      day.classList.toggle("watch-hidden", allHidden);
    });

    // Last-paid section: show only for starred symbols with no upcoming event.
    let lastPaidVisible = 0;
    document.querySelectorAll<HTMLElement>("[data-last-paid-row]").forEach((row) => {
      const sym = row.dataset.symbol ?? "";
      const visible = starred.has(sym) && !upcomingSymbols.has(sym);
      row.classList.toggle("watch-hidden", !visible);
      if (visible) lastPaidVisible++;
    });
    const lastPaidSection = document.querySelector<HTMLElement>("[data-watchlist-last-paid]");
    lastPaidSection?.classList.toggle("hidden", lastPaidVisible === 0);

    list?.classList.toggle("hidden", visibleRows === 0);
    // Only show "no upcoming" when there's nothing in either section.
    const showNoUpcomingHint = visibleRows === 0 && lastPaidVisible === 0;
    noUpcoming?.classList.toggle("hidden", !showNoUpcomingHint);
  }

  document.addEventListener("astro:page-load", applyFilter);
  applyFilter();

  onWatchlistChange(() => applyFilter());

  // Click handler for chip × buttons. Stops propagation so the chip's link
  // doesn't navigate when the user is just unstarring.
  document.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>(
      "[data-chip-unstar]",
    );
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();
    const sym = btn.dataset.symbol;
    if (sym) toggleStar(sym);
  });
</script>
