---
import Layout from "../../layouts/Layout.astro";
import MainNav from "../../components/MainNav.astro";
import MonthCalendar from "../../components/MonthCalendar.astro";
import MonthNav from "../../components/MonthNav.astro";
import PageHeader from "../../components/PageHeader.astro";
import {
  loadEvents,
  getMonthList,
  getEventsForMonth,
  getNeighbourMonths,
  currentYearMonth,
  absoluteUrl,
} from "../../lib/dividends";
import { LANGS, isLang, t, type Lang } from "../../lib/i18n";

export async function getStaticPaths() {
  return LANGS.map((lang) => ({ params: { lang } }));
}

const lang = (isLang(Astro.params.lang) ? Astro.params.lang : "en") as Lang;

const events = loadEvents();
const { months, byKey } = getMonthList(events, lang);
const today = currentYearMonth(new Date(), lang);
const ym = byKey.get(today.key) ?? months[months.length - 1];
const { byDay, totalXd, totalPayment } = getEventsForMonth(events, ym);
const { prev, next } = getNeighbourMonths(months, ym);
const isToday = ym.key === today.key;
const totalAll = events.length;
const uniqueSymbols = new Set(events.map((e) => e.symbol)).size;
const allFeedUrl = absoluteUrl(Astro.site, "/calendar.ics");
---

<Layout lang={lang} title={`${ym.label} - ${t(lang, "siteTitle")}`}>
  <MainNav lang={lang} active="calendar" annualYear={ym.year} />
  <PageHeader
    lang={lang}
    totalXdMonth={totalXd}
    totalPaymentMonth={totalPayment}
    totalAll={totalAll}
    uniqueSymbols={uniqueSymbols}
    feedUrl={allFeedUrl}
  />
  <main class="px-3 sm:px-8 pt-6 pb-16 max-w-[1200px] mx-auto">
    <MonthNav lang={lang} current={ym} prev={prev} next={next} todayPath={today.path} isToday={isToday} />
    <MonthCalendar lang={lang} ym={ym} byDay={byDay} />
  </main>
</Layout>
