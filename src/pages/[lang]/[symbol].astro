---
import Layout from "../../layouts/Layout.astro";
import MainNav from "../../components/MainNav.astro";
import StockHeader from "../../components/StockHeader.astro";
import DividendTimeline from "../../components/DividendTimeline.astro";
import DividendCadence from "../../components/DividendCadence.astro";
import CompanyAbout from "../../components/CompanyAbout.astro";
import RevenueProfit from "../../components/RevenueProfit.astro";
import EarningsDividends from "../../components/EarningsDividends.astro";
import EpsHistory from "../../components/EpsHistory.astro";
import EpsVsDividends from "../../components/EpsVsDividends.astro";
import ValuationHistory from "../../components/ValuationHistory.astro";
import StockIndicators from "../../components/StockIndicators.astro";
import StockMonthCalendar from "../../components/StockMonthCalendar.astro";
import RelatedCompanies from "../../components/RelatedCompanies.astro";
import CalendarSubscribe from "../../components/CalendarSubscribe.astro";
import StarButton from "../../components/StarButton.astro";
import {
  getAllSymbols,
  getCompany,
  getEventsForSymbol,
  getSymbolStats,
  groupEventsByYear,
  getCadence,
  todayIso,
  absoluteUrl,
  type DividendEvent,
} from "../../lib/dividends";
import { getDividendQuality, getEarningsVsDividends, getEpsHistory, getEpsVsDps, getFundamentals, getRevenueProfit, getValuationHistory } from "../../lib/fundamentals";
import { getPopularCompanies, getRelatedCompanies } from "../../lib/related";
import { getSectorStats } from "../../lib/sector-stats";
import { getStockIndicators } from "../../lib/indicators";
import { getPrice, computeCurrentYield, computeCurrentPE } from "../../lib/prices";
import { LANGS, isLang, t, fmtDate, localePath, type Lang } from "../../lib/i18n";
import { parseISO } from "date-fns";

export async function getStaticPaths() {
  const symbols = getAllSymbols();
  const out: Array<{ params: { lang: Lang; symbol: string } }> = [];
  for (const lang of LANGS) {
    for (const symbol of symbols) {
      out.push({ params: { lang, symbol } });
    }
  }
  return out;
}

const lang = (isLang(Astro.params.lang) ? Astro.params.lang : "en") as Lang;
const { symbol } = Astro.params;
const company = getCompany(symbol!);
const events = getEventsForSymbol(symbol!);
const stats = getSymbolStats(events);
const yearGroups = groupEventsByYear(events);
const cadence = getCadence(events);

// 5y / 10y range filtering for Dividends tab visualisations. The pre-2018 PTT
// data shows the problem: huge pre-split values dominate axes & averages.
// Default to 5y; 10y is the wider option.
const today_for_range = new Date();
const cutoff5yDate = new Date(today_for_range);
cutoff5yDate.setFullYear(cutoff5yDate.getFullYear() - 5);
const cutoff5yIso = cutoff5yDate.toISOString().slice(0, 10);
const cutoff10yDate = new Date(today_for_range);
cutoff10yDate.setFullYear(cutoff10yDate.getFullYear() - 10);
const cutoff10yIso = cutoff10yDate.toISOString().slice(0, 10);

const events5y = events.filter((e) => e.exDate >= cutoff5yIso);
const events10y = events.filter((e) => e.exDate >= cutoff10yIso);
const cadence5y = getCadence(events5y);
const cadence10y = getCadence(events10y);
const yearGroups5y = groupEventsByYear(events5y);
const yearGroups10y = groupEventsByYear(events10y);
const confirmedCount5y = events5y.filter((e) => typeof e.amount === "number").length;
const confirmedCount10y = events10y.filter((e) => typeof e.amount === "number").length;
const stats5y = getSymbolStats(events5y);
const stats10y = getSymbolStats(events10y);

// Hide the toggle when both windows show essentially the same data.
const showRangeToggle = events10y.length > events5y.length;
const quality = getDividendQuality(symbol!);
const earningsData = getEarningsVsDividends(symbol!);
const revenueData = getRevenueProfit(symbol!);
const epsHistory = getEpsHistory(symbol!);
const epsDpsRows = getEpsVsDps(symbol!, events);
const hasEpsHistory = epsHistory.annual.length >= 2 || epsHistory.quarterly.length >= 3;
const hasEpsDps = epsDpsRows.length >= 2 && epsDpsRows.some((r) => r.eps !== null);
const valuationHistory = getValuationHistory(symbol!, events);
const hasValuation = valuationHistory.annual.length >= 2 || valuationHistory.quarterly.length >= 3;
const profile = getFundamentals(symbol!)?.profile ?? null;
const priceSnapshot = getPrice(symbol!);
const hasRevenueChart = revenueData.annual.length >= 2 || revenueData.quarterly.length >= 3;
const hasEarningsChart = earningsData.annual.length >= 2 || earningsData.quarterly.length >= 3;
// Tab gating: Dividends always visible. Financials = revenue/profit + valuation.
// Earnings = per-share EPS views (EpsHistory + EpsVsDividends). The Payout
// (net income vs dividends paid) chart lives in the Dividends tab - it's
// answering a dividend question, not a fundamentals one.
const hasFinancials = hasRevenueChart || hasValuation;
const hasEarningsTab = hasEpsHistory || hasEpsDps;
const tabCount = 1 + (hasFinancials ? 1 : 0) + (hasEarningsTab ? 1 : 0);
const today = todayIso();
const todayYear = new Date().getFullYear();
const confirmedCount = events.filter((e) => typeof e.amount === "number").length;
const symbolFeedUrl = absoluteUrl(Astro.site, `/calendar/${symbol}.ics`);
const hasFeed = events.length > 0;

const formatAmount = (n: number): string =>
  n.toFixed(4).replace(/(\.\d{2})0+$/, "$1");

const isFuture = (e: DividendEvent) => (e.paymentDate ?? e.exDate) >= today;
const formatDateShort = (iso: string): string => fmtDate(iso, "dd MMM", lang);
const formatDateLong = (iso: string): string => fmtDate(iso, "dd MMM yyyy", lang);
const formatMonthYear = (iso: string): string => fmtDate(iso, "MMM yyyy", lang);

// Trailing 12 months: sum of confirmed amounts whose ex-date sits in the
// last 365 days. More meaningful than the all-time sum because the tracking
// window varies per stock.
const cutoff = ((): string => {
  const d = parseISO(today);
  d.setUTCFullYear(d.getUTCFullYear() - 1);
  return d.toISOString().slice(0, 10);
})();
const ttmAmount = events.reduce(
  (sum, e) => (typeof e.amount === "number" && e.exDate >= cutoff && e.exDate <= today ? sum + e.amount : sum),
  0,
);
const currentYield = computeCurrentYield(ttmAmount, priceSnapshot);
// Latest TTM EPS: prefer the most recent quarterly row, fall back to annual.
const latestTtmEps = (() => {
  for (let i = valuationHistory.quarterly.length - 1; i >= 0; i--) {
    const r = valuationHistory.quarterly[i];
    if (r.eps !== null && r.eps > 0) return r.eps;
  }
  for (let i = valuationHistory.annual.length - 1; i >= 0; i--) {
    const r = valuationHistory.annual[i];
    if (r.eps !== null && r.eps > 0) return r.eps;
  }
  return null;
})();
const currentPE = computeCurrentPE(latestTtmEps, priceSnapshot);
const ttmCount = events.filter(
  (e) => typeof e.amount === "number" && e.exDate >= cutoff && e.exDate <= today,
).length;

// Smart milestone for the 4th card. Priority:
//   future ex-date  → "Next ex-date"
//   pending payment → "Next payment"   (ex passed, cash hasn't paid yet)
//   else            → "Last paid"
type Milestone = {
  labelKey: "nextExDate" | "nextPayment" | "lastPaid";
  date: string;
  subPrefixKey: "paysPrefix" | "exPrefix" | null;
  subDate: string | null;
};
const milestone: Milestone | null = (() => {
  const futureEx = [...events].reverse().find((e) => e.exDate >= today);
  if (futureEx) {
    return {
      labelKey: "nextExDate",
      date: futureEx.exDate,
      subPrefixKey: futureEx.paymentDate ? "paysPrefix" : null,
      subDate: futureEx.paymentDate,
    };
  }
  const pendingPayment = [...events]
    .reverse()
    .find((e) => e.exDate < today && e.paymentDate && e.paymentDate >= today);
  if (pendingPayment && pendingPayment.paymentDate) {
    return {
      labelKey: "nextPayment",
      date: pendingPayment.paymentDate,
      subPrefixKey: "exPrefix",
      subDate: pendingPayment.exDate,
    };
  }
  const lastPast = events.find((e) => (e.paymentDate ?? e.exDate) < today);
  if (lastPast) {
    return {
      labelKey: "lastPaid",
      date: lastPast.paymentDate ?? lastPast.exDate,
      subPrefixKey: lastPast.paymentDate ? "exPrefix" : null,
      subDate: lastPast.paymentDate ? lastPast.exDate : null,
    };
  }
  return null;
})();

// Snapshot tiles: stock fundamentals from getStockIndicators, plus three
// page-side tiles (TTM amount, next-or-last calendar event, latest EPS) that
// need formatters or milestone calc only available here.
const indicators = getStockIndicators(lang, {
  events,
  valuation: valuationHistory,
  fundamentals: getFundamentals(symbol!),
  revenue: revenueData,
  quality,
  epsHistory,
  currentPE,
  currentYield,
  priceSnapshot,
  sectorStats: getSectorStats(company?.sector),
});
if (events.length > 0) {
  indicators.push(
    ttmCount > 0
      ? {
          labelKey: "statLast12Months",
          value: `${formatAmount(ttmAmount)} ฿`,
          tone: "ok",
          detail: `${ttmCount} ${t(lang, ttmCount === 1 ? "payoutOne" : "payoutMany")}`,
        }
      : { labelKey: "statLast12Months", value: "-", tone: "neutral" },
  );
}
if (milestone) {
  const detail = milestone.subDate
    ? milestone.subPrefixKey
      ? `${t(lang, milestone.subPrefixKey)} ${formatDateShort(milestone.subDate)}`
      : formatDateShort(milestone.subDate)
    : undefined;
  indicators.push({
    labelKey: milestone.labelKey,
    value: formatDateLong(milestone.date),
    tone: "neutral",
    detail,
  });
}
// Latest annual EPS - per-share earnings paired with the per-share dividend
// total above. Skipped when there is no positive annual EPS on file.
const latestAnnualEps = epsHistory.annual[epsHistory.annual.length - 1] ?? null;
if (latestAnnualEps && latestAnnualEps.eps > 0) {
  indicators.push({
    labelKey: "indLatestEps",
    value: `${latestAnnualEps.eps.toFixed(2)} ฿`,
    tone: "neutral",
    detail: String(latestAnnualEps.year),
  });
}

// Cross-page navigation: sector peers near the top, site-wide top payers at
// the bottom. Both lists exclude the current symbol.
const relatedCompanies = getRelatedCompanies(symbol!, 6);
const popularCompanies = getPopularCompanies(symbol!, 8);
const sectorKey = company?.sector ? `sector${company.sector}` : null;
const industryKey = company?.industry ? `industry${company.industry}` : null;
const relatedContextLabel = sectorKey
  ? t(lang, sectorKey)
  : industryKey
    ? t(lang, industryKey)
    : null;
---

<Layout
  lang={lang}
  title={`${symbol} - ${t(lang, "siteTitle")}`}
  description={`Dividend history for ${symbol}${company ? ` (${company.name})` : ""}`}
  ogImagePath={`/og/${encodeURIComponent(symbol!)}.png`}
>
  <MainNav lang={lang} active={null} annualYear={todayYear} />
  <StockHeader lang={lang} />

  <main class="px-4 sm:px-8 pt-8 sm:pt-12 pb-16 max-w-[960px] mx-auto">
    <!-- Ticker masthead -->
    <section class="mb-10 sm:mb-14">
      <div class="flex items-center justify-between gap-3 text-[10px] tracking-[0.22em] uppercase text-muted mb-3">
        <div class="flex items-baseline gap-3 min-w-0">
          <span class="inline-block h-px w-6 bg-text/40 shrink-0"></span>
          <span class="truncate">{t(lang, "tickerLabel")} &middot; {company?.exchange ?? "SET"}</span>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <StarButton lang={lang} symbol={symbol!} variant="default" />
          {hasFeed && (
            <CalendarSubscribe lang={lang} feedUrl={symbolFeedUrl} align="right" variant="compact" />
          )}
        </div>
      </div>
      <h1 class="m-0 font-display text-[clamp(3rem,8vw,5.5rem)] leading-[0.92] tracking-tight text-text">
        <span class="font-semibold">{symbol}</span>
      </h1>
      {company && (
        <p class="mt-3 font-display italic text-[clamp(1.1rem,2vw,1.5rem)] text-muted leading-tight max-w-2xl">
          {company.name}
        </p>
      )}
      {priceSnapshot && (
        <div class="mt-4 flex items-baseline flex-wrap gap-x-4 gap-y-1 text-[13px]">
          <span class="font-display tabular-nums text-[clamp(1.1rem,2vw,1.4rem)] font-medium text-text">
            {priceSnapshot.close.toFixed(2)}
            <span class="text-muted text-[12px] ml-0.5">฿</span>
          </span>
          <span class={`font-display tabular-nums text-[13px] ${
            priceSnapshot.changePercent > 0 ? "text-payment"
            : priceSnapshot.changePercent < 0 ? "text-accent"
            : "text-muted"
          }`}>
            {priceSnapshot.change >= 0 ? "+" : ""}{priceSnapshot.change.toFixed(2)}
            {" "}
            ({priceSnapshot.changePercent >= 0 ? "+" : ""}{priceSnapshot.changePercent.toFixed(2)}%)
          </span>
          {currentYield !== null && (
            <span class="font-display tabular-nums text-[13px] text-payment">
              {t(lang, "priceYieldLabel")} {(currentYield * 100).toFixed(2)}%
            </span>
          )}
          <span class="font-display italic text-[12px] text-muted">
            {t(lang, "priceAsOf")} {formatDateLong(priceSnapshot.asOfDate)}
          </span>
        </div>
      )}
    </section>

    <CompanyAbout lang={lang} company={company} profile={profile} />

    <RelatedCompanies
      lang={lang}
      variant="related"
      companies={relatedCompanies}
      contextLabel={relatedContextLabel}
    />

    <StockIndicators lang={lang} indicators={indicators} />

    {events.length > 0 ? (
      <>
        <div class="stock-tabs" data-active="dividends">
          {tabCount > 1 && (
            <nav role="tablist" aria-label="Stock sections" class="stock-tabnav flex gap-1 mb-10 -mx-4 sm:mx-0 px-4 sm:px-0 border-b border-border overflow-x-auto">
              <button
                role="tab" type="button"
                data-tab-trigger="dividends"
                aria-selected="true"
                aria-controls="tabpanel-dividends"
                class="tab-trigger px-4 py-3 text-[12px] font-sans uppercase tracking-[0.15em] cursor-pointer border-b-2 border-transparent transition-colors whitespace-nowrap bg-transparent"
              >{t(lang, "tabDividends")}</button>
              {hasFinancials && (
                <button
                  role="tab" type="button"
                  data-tab-trigger="financials"
                  aria-selected="false"
                  aria-controls="tabpanel-financials"
                  class="tab-trigger px-4 py-3 text-[12px] font-sans uppercase tracking-[0.15em] cursor-pointer border-b-2 border-transparent transition-colors whitespace-nowrap bg-transparent"
                >{t(lang, "tabFinancials")}</button>
              )}
              {hasEarningsTab && (
                <button
                  role="tab" type="button"
                  data-tab-trigger="earnings"
                  aria-selected="false"
                  aria-controls="tabpanel-earnings"
                  class="tab-trigger px-4 py-3 text-[12px] font-sans uppercase tracking-[0.15em] cursor-pointer border-b-2 border-transparent transition-colors whitespace-nowrap bg-transparent"
                >{t(lang, "tabEarnings")}</button>
              )}
            </nav>
          )}

          <div role="tabpanel" id="tabpanel-dividends" data-tab-panel="dividends">
            {(confirmedCount5y >= 2 || confirmedCount10y >= 2) && (
              <div class="symbol-range mb-14" data-symbol-range="5y">
                <header class="flex items-baseline justify-between mb-4 gap-3 flex-wrap">
                  <h2 class="m-0 font-display text-[clamp(1.25rem,2.5vw,1.625rem)] tracking-tight">
                    <span class="font-medium">{symbol}</span>
                    <span class="italic font-light text-muted ml-2">{t(lang, "sectionDividends")}</span>
                  </h2>
                  {showRangeToggle && (
                    <div class="inline-flex border border-border bg-panel rounded-sm overflow-hidden">
                      <button
                        type="button"
                        data-symbol-range-btn="5y"
                        class="symbol-range-btn px-3 py-1 text-[11px] tracking-[0.1em] uppercase font-sans transition-colors cursor-pointer"
                      >{t(lang, "range5y")}</button>
                      <button
                        type="button"
                        data-symbol-range-btn="10y"
                        class="symbol-range-btn px-3 py-1 text-[11px] tracking-[0.1em] uppercase font-sans transition-colors cursor-pointer border-l border-border"
                      >{t(lang, "range10y")}</button>
                    </div>
                  )}
                </header>
                <div data-symbol-range-pane="5y">
                  {confirmedCount5y >= 2 && <DividendTimeline lang={lang} events={events5y} />}
                </div>
                <div data-symbol-range-pane="10y">
                  {confirmedCount10y >= 2 && <DividendTimeline lang={lang} events={events10y} />}
                </div>
              </div>
            )}

            {(cadence5y.years.length >= 1 || cadence10y.years.length >= 1) && (
              <div class="symbol-range mb-14" data-symbol-range="5y">
                <header class="flex items-baseline justify-between mb-4 gap-3 flex-wrap">
                  <h2 class="m-0 font-display text-[clamp(1.25rem,2.5vw,1.625rem)] tracking-tight">
                    <span class="italic font-light text-muted">{t(lang, "sectionCadence")}</span>
                    <span class="text-text/60 text-[14px] ml-2 font-sans normal-case tracking-normal">{t(lang, "sectionCadenceSub")}</span>
                  </h2>
                  {showRangeToggle && (
                    <div class="inline-flex border border-border bg-panel rounded-sm overflow-hidden">
                      <button
                        type="button"
                        data-symbol-range-btn="5y"
                        class="symbol-range-btn px-3 py-1 text-[11px] tracking-[0.1em] uppercase font-sans transition-colors cursor-pointer"
                      >{t(lang, "range5y")}</button>
                      <button
                        type="button"
                        data-symbol-range-btn="10y"
                        class="symbol-range-btn px-3 py-1 text-[11px] tracking-[0.1em] uppercase font-sans transition-colors cursor-pointer border-l border-border"
                      >{t(lang, "range10y")}</button>
                    </div>
                  )}
                </header>
                <div data-symbol-range-pane="5y">
                  {cadence5y.years.length >= 1 && <DividendCadence lang={lang} cadence={cadence5y} />}
                </div>
                <div data-symbol-range-pane="10y">
                  {cadence10y.years.length >= 1 && <DividendCadence lang={lang} cadence={cadence10y} />}
                </div>
              </div>
            )}

            {hasEarningsChart && (
              <EarningsDividends lang={lang} data={earningsData} />
            )}

            <!-- Dividend history, grouped by year (recent open, older collapsed) -->
            <section class="mb-14">
          <header class="flex items-baseline justify-between mb-4">
            <h2 class="m-0 font-display text-[clamp(1.25rem,2.5vw,1.625rem)] tracking-tight">
              <span class="italic font-light text-muted">{t(lang, "sectionHistory")}</span>
            </h2>
            <span class="text-[11px] tracking-[0.15em] uppercase text-muted">
              {events.length} {t(lang, events.length === 1 ? "eventOne" : "eventMany")}
              {", "}
              {t(lang, "sinceLabel")} {stats.firstDate ? formatMonthYear(stats.firstDate) : "-"}
            </span>
          </header>

          <div class="border-t border-border">
            {yearGroups.map((group, idx) => {
              const isOpen = idx < 2;
              const yearTotal = group.events.reduce(
                (s, e) => s + (typeof e.amount === "number" ? e.amount : 0),
                0,
              );
              const hasUpcoming = group.events.some(isFuture);
              return (
                <details class="year-block group/y border-b border-border" open={isOpen}>
                  <summary class="year-summary flex items-baseline gap-3 sm:gap-4 py-4 cursor-pointer list-none select-none hover:bg-panel/40 transition-colors px-1 -mx-1">
                    <svg viewBox="0 0 8 8" class="w-2 h-2 shrink-0 text-muted/70 transition-transform duration-200 group-open/y:rotate-90" aria-hidden="true">
                      <path d="M2 1 L6 4 L2 7 Z" fill="currentColor" />
                    </svg>
                    <span class="font-display tabular-nums text-[clamp(1.4rem,3vw,1.875rem)] font-medium leading-none">
                      {group.year}
                    </span>
                    <span class="text-[10px] sm:text-[11px] uppercase tracking-[0.15em] text-muted font-sans">
                      {group.events.length} {t(lang, group.events.length === 1 ? "eventOne" : "eventMany")}
                    </span>
                    {hasUpcoming && (
                      <span class="text-[9px] font-bold uppercase tracking-[0.18em] bg-accent text-bg px-1.5 py-0.5">
                        {t(lang, "badgeUpcoming")}
                      </span>
                    )}
                    <span class="flex-1 border-b border-dotted border-border/70 self-center mx-1"></span>
                    <span class="font-display tabular-nums text-base sm:text-lg text-text leading-none">
                      {formatAmount(yearTotal)}
                      <span class="text-muted text-xs sm:text-sm ml-0.5">฿</span>
                    </span>
                  </summary>
                  <ul class="m-0 p-0 list-none flex flex-col pb-2">
                    {group.events.map((e) => {
                      const upcoming = isFuture(e);
                      return (
                        <li class={`event-row-compact grid grid-cols-[5.5rem_1fr_auto] sm:grid-cols-[6.5rem_1fr_auto] items-baseline gap-x-3 sm:gap-x-4 py-2.5 pl-7 sm:pl-8 border-t border-border/50 text-[13px] ${
                          upcoming ? "border-l-2 border-l-accent" : ""
                        }`}>
                          <span class="font-display tabular-nums text-text">
                            {formatDateShort(e.exDate)}
                          </span>
                          <div class="text-muted text-[12px] flex flex-wrap items-baseline gap-x-3 gap-y-1 min-w-0">
                            {e.tentative && (
                              <span class="text-accent text-[9px] font-bold uppercase tracking-[0.15em]">{t(lang, "badgeTentative")}</span>
                            )}
                            {e.caType !== "XD" && (
                              <span class="text-muted text-[9px] font-bold uppercase tracking-[0.15em] border border-border px-1">
                                {e.caType}
                              </span>
                            )}
                            {e.paymentDate && (
                              <span>
                                <span class="text-faint">{t(lang, "paidVerb")}</span>{" "}
                                <span class="font-display italic text-text/85">{formatDateShort(e.paymentDate)}</span>
                              </span>
                            )}
                            {e.dividendType !== "Cash Dividend" && <span>{e.dividendType}</span>}
                            {e.sourceOfDividend && e.sourceOfDividend !== "Retained Earnings" && (
                              <span class="text-faint">{e.sourceOfDividend}</span>
                            )}
                          </div>
                          <span class={`font-display tabular-nums leading-none text-[15px] sm:text-base whitespace-nowrap ${
                            e.amount === null ? "text-muted italic" : "font-semibold text-text"
                          }`}>
                            {e.amount === null ? "-" : formatAmount(e.amount)}
                            <span class="text-muted text-[10px] ml-0.5">฿</span>
                          </span>
                        </li>
                      );
                    })}
                  </ul>
                </details>
              );
            })}
          </div>
        </section>

            <StockMonthCalendar lang={lang} symbol={symbol!} events={events} />

          </div>

          {hasFinancials && (
            <div role="tabpanel" id="tabpanel-financials" data-tab-panel="financials">
              {hasRevenueChart && (
                <RevenueProfit lang={lang} data={revenueData} />
              )}
              {hasValuation && (
                <ValuationHistory lang={lang} history={valuationHistory} currentYield={currentYield} currentPE={currentPE} />
              )}
            </div>
          )}

          {hasEarningsTab && (
            <div role="tabpanel" id="tabpanel-earnings" data-tab-panel="earnings">
              {hasEpsHistory && <EpsHistory lang={lang} history={epsHistory} />}
              {hasEpsDps && <EpsVsDividends lang={lang} rows={epsDpsRows} />}
            </div>
          )}
        </div>

        <style>
          /* Hide native disclosure marker - we use our own chevron */
          .year-summary::-webkit-details-marker { display: none; }
          .year-summary { list-style: none; }

          /* Tabs: only render the active panel; switch via data-active attr */
          .stock-tabs [role="tabpanel"] { display: none; }
          .stock-tabs[data-active="dividends"] [data-tab-panel="dividends"],
          .stock-tabs[data-active="financials"] [data-tab-panel="financials"],
          .stock-tabs[data-active="earnings"] [data-tab-panel="earnings"] {
            display: block;
          }

          .stock-tabnav .tab-trigger { color: var(--muted); }
          .stock-tabnav .tab-trigger:hover { color: var(--text); }
          .stock-tabs[data-active="dividends"] [data-tab-trigger="dividends"],
          .stock-tabs[data-active="financials"] [data-tab-trigger="financials"],
          .stock-tabs[data-active="earnings"] [data-tab-trigger="earnings"] {
            color: var(--text);
            border-bottom-color: var(--accent);
          }
          .stock-tabnav .tab-trigger:focus-visible {
            outline: 2px solid var(--accent);
            outline-offset: -2px;
          }

          /* 5y / 10y range toggle */
          .symbol-range [data-symbol-range-pane] { display: none; }
          .symbol-range[data-symbol-range="5y"] [data-symbol-range-pane="5y"],
          .symbol-range[data-symbol-range="10y"] [data-symbol-range-pane="10y"] {
            display: block;
          }
          .symbol-range[data-symbol-range="5y"] [data-symbol-range-btn="5y"],
          .symbol-range[data-symbol-range="10y"] [data-symbol-range-btn="10y"] {
            background: var(--text);
            color: var(--bg);
          }
          .symbol-range[data-symbol-range="5y"] [data-symbol-range-btn="10y"],
          .symbol-range[data-symbol-range="10y"] [data-symbol-range-btn="5y"] {
            background: transparent;
            color: var(--muted);
          }
        </style>

        <script>
          // Tab switching for the stock page. Delegated so it survives any
          // re-render and works regardless of which tabs are present.
          document.addEventListener("click", (e) => {
            const trigger = (e.target as HTMLElement).closest<HTMLElement>("[data-tab-trigger]");
            if (!trigger) return;
            const wrap = trigger.closest<HTMLElement>(".stock-tabs");
            if (!wrap) return;
            const target = trigger.dataset.tabTrigger ?? "dividends";
            wrap.dataset.active = target;
            wrap.querySelectorAll<HTMLElement>("[data-tab-trigger]").forEach((t) => {
              t.setAttribute("aria-selected", String(t.dataset.tabTrigger === target));
            });
          });
          // 5y / 10y range toggle for Timeline + Cadence
          document.addEventListener("click", (e) => {
            const btn = (e.target as HTMLElement).closest<HTMLElement>("[data-symbol-range-btn]");
            if (!btn) return;
            const wrap = btn.closest<HTMLElement>(".symbol-range");
            if (!wrap) return;
            wrap.dataset.symbolRange = btn.dataset.symbolRangeBtn ?? "5y";
          });
          // Keyboard nav: arrow keys move focus + activate within the tablist.
          document.addEventListener("keydown", (e) => {
            const target = e.target as HTMLElement | null;
            if (!target) return;
            const trigger = target.closest<HTMLElement>("[data-tab-trigger]");
            if (!trigger) return;
            if (e.key !== "ArrowLeft" && e.key !== "ArrowRight") return;
            const tabs = Array.from(
              (trigger.closest<HTMLElement>(".stock-tabnav")?.querySelectorAll<HTMLElement>("[data-tab-trigger]")) ?? [],
            );
            const idx = tabs.indexOf(trigger);
            if (idx < 0) return;
            const next = e.key === "ArrowRight" ? tabs[(idx + 1) % tabs.length] : tabs[(idx - 1 + tabs.length) % tabs.length];
            next.focus();
            next.click();
            e.preventDefault();
          });
        </script>
      </>
    ) : (
      <section class="py-12 text-center">
        <p class="text-muted text-[15px]">{t(lang, "noRecordsBefore")} {symbol}{t(lang, "noRecordsAfter")}</p>
        <a href={localePath(lang, "/")} class="inline-block mt-4 text-accent text-[13px] hover:underline">
          {t(lang, "backToCalendar")}
        </a>
      </section>
    )}

    <RelatedCompanies
      lang={lang}
      variant="popular"
      companies={popularCompanies}
    />
  </main>
</Layout>
