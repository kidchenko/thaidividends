---
import { withBase } from "../lib/dividends";
const enHref = withBase("/en/");
const thHref = withBase("/th/");
const faviconHref = withBase("/favicon.svg");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Thai Dividends Calendar</title>
    <link rel="icon" type="image/svg+xml" href={faviconHref} />
    <meta http-equiv="refresh" content={`0;url=${enHref}`} />
    <link rel="alternate" hreflang="en" href={enHref} />
    <link rel="alternate" hreflang="th" href={thHref} />
    <link rel="alternate" hreflang="x-default" href={enHref} />
    <script is:inline define:vars={{ enHref, thHref }}>
      (function () {
        var stored = null;
        try { stored = localStorage.getItem("lang"); } catch (e) {}
        var lang = stored === "th" || stored === "en"
          ? stored
          : ((navigator.language || "").toLowerCase().startsWith("th") ? "th" : "en");
        var target = lang === "th" ? thHref : enHref;
        location.replace(target);
      })();
    </script>
  </head>
  <body>
    <p>
      Redirecting to <a href={enHref}>English</a> /
      <a href={thHref}>ภาษาไทย</a>…
    </p>
  </body>
</html>
